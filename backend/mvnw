# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

set_java_home() {
  if [ -n "${JAVA_HOME-}" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
      JAVACMD="$JAVA_HOME/jre/sh/java"
      JAVACMD="$JAVA_HOME/jre/sh/javac"
    else
      JAVACMD="$JAVA_HOME/bin/java"
      JAVACMD="$JAVA_HOME/bin/javac"
      [ -x "$JAVACMD" ] || { echo "JAVA_HOME/bin/java not found" >&2; return 1; }
    fi
  else
    JAVACMD="$(command -v java 2>/dev/null)" || :
    JAVACMD="$(command -v javac 2>/dev/null)" || :
    [ -x "${JAVACMD-}" ] || { echo "java not found in PATH" >&2; return 1; }
  fi
}

hash_string() {
  str="${1:-}" h=0
  while [ -n "$str" ]; do
    char="${str%"${str#?}"}"
    h=$(((h * 31 + $(LC_CTYPE=C printf %d "'$char")) % 4294967296))
    str="${str#?}"
  done
  printf %x\\n $h
}

verbose() { :; }
[ "${MVNW_VERBOSE-}" = true ] && verbose() { printf %s\\n "${1-}"; }

die() { printf %s\\n "$1" >&2; exit 1; }

trim() { printf "%s" "${1}" | tr -d '[:space:]'; }

scriptDir="$(cd "$(dirname "$0")" && pwd)"

while IFS="=" read -r key value; do
  case "${key-}" in
  distributionUrl) distributionUrl=$(trim "${value-}") ;;
  distributionSha256Sum) distributionSha256Sum=$(trim "${value-}") ;;
  esac
done <"$scriptDir/.mvn/wrapper/maven-wrapper.properties"
[ -n "${distributionUrl-}" ] || die "cannot read distributionUrl"

case "${distributionUrl##*/}" in
*-bin.zip) MVN_CMD="mvn" ;;
*) die "distributionUrl must end with -bin.zip";;
esac

[ -z "${MVNW_REPOURL-}" ] || true
distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
distributionUrlNameMain="${distributionUrlNameMain%-bin}"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${distributionUrlNameMain-}/$(hash_string "$distributionUrl")"

exec_maven() {
  exec "$MAVEN_HOME/bin/$MVN_CMD" "$@" || die "cannot exec $MAVEN_HOME/bin/$MVN_CMD"
}

if [ -d "$MAVEN_HOME" ]; then
  [ "${MVNW_VERBOSE-}" = true ] && echo "found MAVEN_HOME at $MAVEN_HOME"
  exec_maven "$@"
fi

TMP_DOWNLOAD_DIR="$(mktemp -d)" || die "cannot create temp dir"
trap 'rm -rf "$TMP_DOWNLOAD_DIR"' HUP INT TERM EXIT
mkdir -p "${MAVEN_HOME%/*}"

[ "${MVNW_VERBOSE-}" = true ] && echo "Downloading Maven from $distributionUrl"

if command -v curl >/dev/null; then
  curl -fsSL -o "$TMP_DOWNLOAD_DIR/$distributionUrlName" "$distributionUrl" || die "curl failed"
elif command -v wget >/dev/null; then
  wget -q -O "$TMP_DOWNLOAD_DIR/$distributionUrlName" "$distributionUrl" || die "wget failed"
else
  die "curl or wget required to download Maven"
fi

command -v unzip >/dev/null || die "unzip required"
unzip -q "$TMP_DOWNLOAD_DIR/$distributionUrlName" -d "$TMP_DOWNLOAD_DIR"
actualDir=""
set +f
for d in "$TMP_DOWNLOAD_DIR"/*; do
  if [ -d "$d" ] && [ -f "$d/bin/mvn" ]; then
    actualDir="$d"
    break
  fi
done
set -f
[ -n "$actualDir" ] || die "Could not find mvn in archive"
mv "$actualDir" "$MAVEN_HOME" || die "Failed to move Maven"
exec_maven "$@"
